{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "pulse-speedtest",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "speedtest.hosts.zslab.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
