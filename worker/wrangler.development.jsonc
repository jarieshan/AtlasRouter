{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-router-development",
  "main": "src/index.js",
  "compatibility_date": "2026-05-12",
  "minify": true,
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "UI_ENABLED": "false",
    "SUBSCRIPTION_PATH": "/AtlasRouter-Dev",
    "SUBSCRIPTION_VARIANT": "development",
    "SMART_PRIORITY_SCHEME": "geometric-10",
    "SHOW_ALL_PROXY_GROUPS": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-router-dev",
      "database_id": "af8d5520-678b-4fe7-b8eb-8d0ee214aaa1",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true
  }
}
