{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-router",
  "main": ".wrangler/branches/index.js",
  "compatibility_date": "2026-05-12",
  "minify": true,
  "placement": {
    "mode": "smart"
  },
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "atlasrouter.zslab.ai",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-router",
      "database_id": "c97ab4f9-cbbc-4aa3-a51d-c440b39489db",
      "migrations_dir": ".wrangler/branches/master/migrations"
    },
    {
      "binding": "DEV_DB",
      "database_name": "atlas-router-dev",
      "database_id": "af8d5520-678b-4fe7-b8eb-8d0ee214aaa1",
      "migrations_dir": ".wrangler/branches/develop/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "DEV_SMART_PRIORITY_SCHEME": "geometric-3"
  }
}
