{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-router",
  "main": "src/index.js",
  "compatibility_date": "2026-05-12",
  "workers_dev": true,
  "secrets": {
    "required": [
      "SUBSCRIBE_TOKEN",
      "NODES_TEXT"
    ]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
